% layout 'bootstrap';
% title "Worker " . $worker->{name};

% content_for 'ready_function' => begin
    is_operator = <%= (is_operator) ? 'true' : 'false' %>;
    restart_url = "<%= url_for("apiv1_restart", jobid => 'REPLACEIT') %>";
    cancel_url = "<%= url_for("apiv1_cancel", jobid => 'REPLACEIT') %>";
    updateTimeago();
    setupResultButtons();
    setupWorkerNeedles();
% end

<div class="row">
    <div class="col-sm-12">
        <h2><%= title %></h2>

    %= include 'layouts/info'

    <div class="card">
        <div class="card-body status-info">
            <div><span>Host: </span>
                % if (exists $worker->{host} && $worker->{host} ne 'unknown' && $worker->{host} ne '') {
                    <a href="<%= url_for('admin_worker_host_show', worker_host => $worker->{host}) %>"><%= $worker->{host} %></a>
                % } else {
                    <%= $worker->{host} // 'unknown' %>
                % }
            </div>
            <div><span>Instance: </span><%= $worker->{instance} %></div>
            <div><span>Seen: </span><abbr class="timeago" title="<%= $worker->{t_seen} %>"><%= $worker->{t_seen} %></abbr></div>
            <div><span>Status: </span><%= include 'admin/workers/worker_status' %></div>
        </div>
    </div>

    <div class="card my-3">
        <div class="card-header">Reservation</div>
        <div class="card-body" id="reservation">
            % if (my $reservation = $worker->{reservation}) {
                <p><strong>Reserved by:</strong> <%= $reservation->{user} %></p>
                % if ($reservation->{worker_class}) {
                <p><strong>Specific class:</strong> <%= $reservation->{worker_class} %></p>
                % }
                <p><strong>Comment:</strong> <%= $reservation->{comment} %></p>
                <p><strong>Reserved at:</strong> <abbr class="timeago" title="<%= $reservation->{t_created} %>"><%= $reservation->{t_created} %></abbr></p>
                <p><strong>Expires:</strong>
                    % if ($reservation->{t_expires}) {
                        <abbr class="timeago" title="<%= $reservation->{t_expires} %>"><%= $reservation->{t_expires} %></abbr>
                    % } else {
                        Never (indefinite)
                    % }
                </p>
                % if (is_operator) {
                    <button class="btn btn-danger" data-worker-id="<%= $worker->{id} %>" onclick="releaseWorker(this)">Release reservation</button>
                    % if ($reservation->{t_expires}) {
                        <button class="btn btn-success" data-worker-id="<%= $worker->{id} %>" data-worker-name="<%= $worker->{name} %>" onclick="openExtendModal(this)">Extend Reservation</button>
                    % }
                % }
                % if (my $job = $worker->{job_info}) {
                    <div class="alert alert-warning mt-3">
                        <h5>Worker is currently finishing Job #<%= $job->{id} %></h5>
                        <p><strong>Test:</strong> <%= $job->{test} %></p>
                        % if ($job->{t_started}) {
                            <p><strong>Running for:</strong> <abbr class="timeago" title="<%= DateTime->from_epoch(epoch => $job->{t_started}, time_zone => 'UTC')->datetime . 'Z' %>"><%= $job->{t_started} %></abbr></p>
                        % }
                        % if (is_operator) {
                            <button class="btn btn-warning btn-sm" onclick="abortJob(<%= $job->{id} %>)">Emergency Abort</button>
                        % }
                    </div>
                % }
            % } else {
                <p>This worker is not reserved.</p>
                % if (is_operator) {
                    <button class="btn btn-success" data-worker-id="<%= $worker->{id} %>" data-worker-name="<%= $worker->{name} %>" data-worker-host="<%= $worker->{host} %>" onclick="openReserveModal(this)">Reserve worker</button>
                % }
            % }
        </div>
    </div>

    % if (is_operator) {
        <h3>Properties</h3>
        <table class="table table-striped">
            <thead>
                <th>Key</th>
                <th>Value</th>
            </thead>
            <tbody>
                % for my $k (sort keys %{$worker->{properties}}) {
                    <tr>
                        <td><%= $k %></td>
                        <td><%= $worker->{properties}->{$k} %></td>
                    </tr>
                % }
            </tbody>
        </table>
    % }

    <h3>Previous jobs</h3>
    <table id="previous_jobs" class="table table-striped"
      data-ajax-url="<%= url_for('admin_worker_previous_jobs_ajax', worker_id => $worker->{id}) %>">
        <thead>
            <th>Test</th>
            <th>Result</th>
            <th>Finished</th>
        </thead>
    </table>
</div>

</div>

%= include 'admin/workers/reserve_modal' if is_operator
