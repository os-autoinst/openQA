% my $reservation = $worker->{reservation};
% my $reservation_details = '';
% if ($reservation) {
%     my $user = escape_html($reservation->{user});
%     my $class = $reservation->{worker_class} ? '<br>Class: ' . escape_html($reservation->{worker_class}) : '';
%     my $comment = escape_html($reservation->{comment});
%     my $expires = escape_html($reservation->{t_expires} // 'never');
%     $reservation_details = "Reserved by: $user$class<br>Comment: $comment<br>Expires: $expires";
% }
% if($worker->{status} eq 'running') {
    <%= $reservation ? 'Working (Reserved)' : 'Working' %>
    % my $job_link = link_to($worker->{jobid}, url_for('test', testid => $worker->{jobid}));
    % my $step_info = defined($worker->{currentstep}) ? "<br> Step: $worker->{currentstep}" : '';
    % my $res_info = $reservation_details ? "<br>$reservation_details" : '';
    <%= help_popover('Worker status' => "Job: $job_link$step_info$res_info") %>
% } elsif ($worker->{status} eq 'reserved') {
    Reserved <%= $reservation->{worker_class} ? '(class ' . escape_html($reservation->{worker_class}) . ')' : '' %>
    <%= help_popover('Worker status' => $reservation_details) %>
% } elsif ($worker->{status} eq 'dead' && $worker->{job}) {
    Dead
    % my $job_link = link_to($worker->{jobid}, url_for('test', testid => $worker->{jobid}));
    <%= help_popover('Worker status' => "Dead with job: $job_link") %>
% } elsif ($worker->{status} eq 'broken') {
    Unavailable <%= help_popover(Details => $worker->{error}) %>
% } elsif ($worker->{alive}) {
    Idle
% } else {
    Offline
    % if (my $note = $worker->{offline_note}) {
        (<%= $note %>)
    % }
% }
