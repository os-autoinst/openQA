<div class="modal fade" id="reserveModal" tabindex="-1" aria-labelledby="reserveModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="reserveModalLabel">Reserve worker</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form id="reserveForm" onsubmit="submitReserve(event)">
        <input type="hidden" id="reserveWorkerId">
        <input type="hidden" id="reserveHostName">
        <input type="hidden" id="reserveMode" value="reserve">
        <div class="modal-body">
          <div id="reserveModalFlash"></div>
          <p>A reservation prevents new jobs from being assigned to this worker, taking it out of the scheduling rotation without interrupting any currently running job.</p>
          <div class="mb-3" id="reserveScopeContainer" style="display: none;">
            <label class="form-label d-block">Scope</label>
            <div class="form-check form-check-inline">
              <input class="form-check-input" type="radio" name="reserveScope" id="reserveScopeInstance" value="instance" checked>
              <label class="form-check-label" for="reserveScopeInstance">This instance</label>
            </div>
            <div class="form-check form-check-inline">
              <input class="form-check-input" type="radio" name="reserveScope" id="reserveScopeHost" value="host">
              <label class="form-check-label" for="reserveScopeHost">All instances on host <span id="reserveScopeHostName" class="fw-bold"></span></label>
            </div>
          </div>
          <div class="mb-3">
            <label for="reserveWorkerName" class="form-label">Worker</label>
            <input type="text" class="form-control" id="reserveWorkerName" readonly>
          </div>
          <div class="mb-3" id="reserveCommentGroup">
            <label for="reserveComment" class="form-label">Comment (required)</label>
            <input type="text" class="form-control" id="reserveComment" required>
          </div>
          <div class="mb-3">
            <label for="reserveDuration" class="form-label" id="reserveDurationLabel">Duration (e.g. 5h, 2d, 3600; 0 for indefinite)</label>
            <select class="form-select mb-2" id="reserveDurationPreset" onchange="usePresetDuration(this)">
              <option value="">Custom...</option>
              <option value="30m">30 Minutes</option>
              <option value="1h">1 Hour</option>
              <option value="2h">2 Hours</option>
              <option value="4h">4 Hours</option>
              <option value="8h">8 Hours</option>
              <option value="1d">1 Day</option>
              <option value="2d">2 Days</option>
            </select>
            <input type="text" class="form-control" id="reserveDuration"
                   data-default-duration="<%= $reservation_default_duration %>">
          </div>
          <div class="mb-3">
            <label for="reserveWorkerClass" class="form-label">Specific worker class (Optional)</label>
            <input type="text" class="form-control" id="reserveWorkerClass" pattern="[a-zA-Z0-9_#.:-]+" title="Only alphanumeric, hashes, dots, colons, and hyphens allowed">
            <div class="form-text">Jobs must explicitly request this class to run on the reserved worker, in addition to the worker's regular capability classes.</div>
          </div>
          % if (is_admin) {
            <div class="form-check mb-3" id="reserveForceGroup">
              <input class="form-check-input" type="checkbox" id="reserveForce" value="1">
              <label class="form-check-label" for="reserveForce">Force (admin override)</label>
            </div>
          % }
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary" id="reserveSubmitBtn">Reserve</button>
        </div>
      </form>
    </div>
  </div>
</div>
