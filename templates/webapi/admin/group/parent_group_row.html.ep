<li
    id="parent_group_<%= $group->id %>"
    data-initial-index="<%= $index %>"
    data-initial-parent="<%= $parent_id %>"
>
    <div
        % if (is_admin) {
            class="no-enforce-parent-drop parent_group_row_div"
            draggable="true"
        % }
    >
        % if (is_admin) {
            <div
                class="enforce-parent-drop"
            >
            </div>
        % }
        % if (is_admin) {
            <a href="#" class="show-add-job-group-btn fa-solid fa-2 fa-plus" title="Add new job group in <%= $group->name %>"></a>
            <a href="#" class="delete-parent-group-btn fa-solid fa-trash" title="Delete parent group <%= $group->name %>"></a>
        % }
        <span class="fa-solid fa-2 fa-folder" aria-hidden="true"></span>
        <span class="parent-group-name">
            %= link_to $group->name => url_for('admin_edit_parent_group', groupid => $group->id)
        </span>
    </div>
    <ul>
        % my $child_index = 0;
        % for my $child_group ($group->children) {
            %= include 'admin/group/job_group_row', is_parent => 0, group => $child_group, index => $child_index, parent => $group->id, parent_id => $group->id
            % ++$child_index;
        % }
    </ul>
</li>
