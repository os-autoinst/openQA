<li
    id="job_group_<%= $group->id %>"
    data-initial-index="<%= $index %>"
    data-initial-parent="<%= $parent_id %>"
>
    <div
        % if (is_admin) {
            class="job_group_row_div"
            draggable="true"
        % }
    >
        % if (is_admin) {
            <div
                class="enforce-parent-drop"
            >
            </div>
            <a href="#" class="delete-job-group-btn fa-solid fa-trash" title="Delete job group <%= $group->name %>"></a>
        % }
        <i class="fa-solid fa-bars"></i>
        <span>
            %= link_to $group->name => url_for('admin_job_templates', groupid => $group->id)
        </span>
    </div>
</li>
