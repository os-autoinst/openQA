% layout 'bootstrap';
% title 'Change Password';
<div class="row justify-content-center">
    <div class="col-md-6 col-lg-4">
        %= include 'layouts/info'
        <div class="card mt-4">
            <div class="card-header">Change Password</div>
            <div class="card-body">
                %= form_for 'password_change' => (method => 'post') => begin
                    %= csrf_field
                    <div class="mb-3">
                        <label class="form-label" for="new_password">New password</label>
                        <input type="password" class="form-control" id="new_password" name="new_password" minlength="8" required>
                    </div>
                    <div class="mb-3">
                        %= submit_button 'Change password', class => 'btn btn-primary w-100'
                    </div>
                % end
            </div>
        </div>
        <div class="card mt-4 border-danger">
            <div class="card-header text-danger">Delete Account</div>
            <div class="card-body">
                %= form_for 'delete_account' => (method => 'post') => begin
                    %= csrf_field
                    <div class="mb-3">
                        %= submit_button 'Delete Account', class => 'btn btn-danger w-100'
                    </div>
                % end
            </div>
        </div>
    </div>
</div>
