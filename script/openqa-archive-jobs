#!/usr/bin/env perl

# Copyright SUSE LLC
# SPDX-License-Identifier: GPL-2.0-or-later

use Mojo::Base -strict, -signatures;

use FindBin qw($RealBin);
use lib "$RealBin/../lib";

use Getopt::Long::Descriptive;
use Feature::Compat::Try;
use Mojo::File qw(path);
use OpenQA::Schema;

my ($opt, $usage) = describe_options(
    <<"EOM",
$0 %o [<job id> ...]

Archive the results of the specified openQA jobs: copy each job's result
directory into the archive location (OPENQA_ARCHIVEDIR, default
<OPENQA_BASEDIR>/openqa/archive), flag the job as archived and remove the
original result directory.

No retention, importance or disk-space based selection is applied; every job
given on the command line (or via --file) is archived. Jobs that are already
archived or not yet finished are skipped. Minion locks of running Gru tasks
are neither checked nor taken.

Run as the user owning the result directories (usually geekotest).
EOM
    ['file|f=s', 'Read job IDs (whitespace/comma separated) from file, "-" for STDIN'],
    ['dry-run|n', 'Only show what would be done'],
    ['help|h', 'Print usage message and exit', {shortcircuit => 1}],
);

if ($opt->help) {
    print $usage->text;
    exit 0;
}

sub parse_ids (@chunks) {
    my @ids;
    for my $token (map { split /[\s,]+/ } @chunks) {
        next unless length $token;
        die "Invalid job ID '$token'\n" unless $token =~ /^\d+$/;
        push @ids, $token;
    }
    return @ids;
}

my @input = @ARGV;
if (my $file = $opt->file) {
    push @input, $file eq '-' ? do { local $/; <STDIN> } : path($file)->slurp;
}
my %seen;
my @job_ids = grep { !$seen{$_}++ } parse_ids(@input);
unless (@job_ids) {
    print STDERR "No job IDs specified.\n", $usage->text;
    exit 1;
}

my $schema = OpenQA::Schema::connect_db(deploy => 0, silent => 1, from_script => 1);

# returns the outcome category and a message
sub archive_job ($job_id) {
    my $job = $schema->resultset('Jobs')->find($job_id);
    return (skipped => 'does not exist, skipping') unless $job;
    return (skipped => 'already archived, skipping') if $job->archived;
    return (skipped => "not finished (state: @{[$job->state]}), skipping") unless $job->is_final;

    if ($opt->dry_run) {
        my $result_dir = $job->result_dir;
        return (skipped => 'has no result directory, would only be flagged as archived')
          unless $result_dir && -d $result_dir;
        my $archived_dir = $job->add_result_dir_prefix($job->remove_result_dir_prefix($result_dir), 1);
        return (archived => "would move $result_dir to $archived_dir");
    }

    my $ret = $job->archive;
    return (skipped => 'skipped (archived or changed meanwhile)') unless defined $ret;
    return (flagged => 'no result directory, flagged as archived') if ref $ret;
    return (archived => "archived to $ret");
}

my %count = (archived => 0, flagged => 0, skipped => 0, failed => 0);
my $total = @job_ids;
my $index = 0;
for my $job_id (@job_ids) {
    my $prefix = '[' . ++$index . "/$total] job $job_id:";
    try {
        my ($outcome, $message) = archive_job($job_id);
        ++$count{$outcome};
        print "$prefix $message\n";
    }
    catch ($e) {
        chomp $e;
        ++$count{failed};
        print STDERR "$prefix failed: $e\n";
    }
}

print "\nSummary: "
  . join(', ', map { "$_: $count{$_}" } qw(archived flagged skipped failed))
  . ($opt->dry_run ? ' (dry run)' : '') . "\n";
exit($count{failed} ? 1 : 0);
